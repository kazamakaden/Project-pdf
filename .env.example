# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env)
#
# ── ฝั่งเบราว์เซอร์ (เฉพาะค่าที่ขึ้นต้นด้วย VITE_ เท่านั้นที่ถูกฝังลงไฟล์ JS) ──
# 1) Google OAuth Client ID (Web application)
#    https://console.cloud.google.com/apis/credentials
#    Authorized JavaScript origins ต้องมี http://localhost:5173 และโดเมนจริง
VITE_GOOGLE_CLIENT_ID=

# 2) อีเมล Google ของเจ้าของเว็บ (คนเดียวที่มีสิทธิ์เพิ่ม/แก้ไขสินค้า)
VITE_ADMIN_EMAIL=owner@gmail.com

# 3) (ทางเลือก) ที่อยู่ API ถ้าแยกโดเมนจากเว็บ — ปกติเว้นว่างไว้ (เรียก /api เดียวกัน)
VITE_API_URL=

# ── ฝั่งเซิร์ฟเวอร์ / Netlify Functions (ความลับ ห้ามขึ้นต้นด้วย VITE_) ──
# 4) MongoDB Atlas connection string (Database: udtc, Collection: products)
#    ตัวอย่าง: mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# 5) ชื่อฐานข้อมูล (เว้นว่าง = udtc)
MONGODB_DB=udtc

# 6) อีเมลแอดมินที่ API ยอมรับ (เว้นว่าง = ใช้ VITE_ADMIN_EMAIL)
ADMIN_EMAIL=

# 7) Google Client ID สำหรับตรวจ ID token ฝั่งเซิร์ฟเวอร์ (เว้นว่าง = ใช้ VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

