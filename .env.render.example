# ─────────────────────────────────────────────────────────────
# ไฟล์นี้ใช้ "วางใน Render" โดยตรง
# Render Dashboard → เลือก service → Environment → ปุ่ม Add from .env → วางทั้งไฟล์นี้ → Save
# (ห้าม commit ไฟล์ที่มีค่าจริง — ไฟล์นี้เป็นแบบฟอร์มเปล่า ปลอดภัย)
# ─────────────────────────────────────────────────────────────

# 1) Google OAuth Client ID (ใช้ทั้งฝั่งเว็บและตรวจ token ฝั่งเซิร์ฟเวอร์)
#    Authorized JavaScript origins ต้องเพิ่มโดเมน Render ด้วย เช่น https://udtc-quotation.onrender.com
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# 2) อีเมลเจ้าของเว็บ (คนเดียวที่แก้ไขสินค้าได้)
VITE_ADMIN_EMAIL=
ADMIN_EMAIL=

# 3) MongoDB Atlas connection string (ข้อมูลสินค้าจริงอยู่ที่นี่)
MONGODB_URI=
MONGODB_DB=udtc

# 4) เว้นว่างไว้ — เว็บเรียก API ที่โดเมนเดียวกัน
VITE_API_URL=
